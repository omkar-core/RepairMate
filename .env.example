# ------------------------------------------------------------------
# RepairMate AI - Environment Configuration
# Secrets are SERVER-ONLY. Never prefix them with VITE_ and never
# commit this file or real .env files to the repository.
# ------------------------------------------------------------------

# ---- Required (server-side) ---------------------------------------
# Google Gemini API key used by the backend only. Kept out of the
# frontend bundle. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ---- Optional: server ---------------------------------------------
# Port the API server listens on.
PORT=3001

# Gemini model identifier. Do not change unless you know what you are doing.
GEMINI_MODEL="gemini-3-flash-preview"

# Comma-separated list of allowed browser origins (CORS).
# Empty = development defaults (localhost:3000, :5173).
# Example for production: CORS_ORIGIN="https://repairmate.example.com"
CORS_ORIGIN=""

# Set to "true" when running behind a reverse proxy (Vercel, Render,
# Cloud Run, nginx) so rate limiting uses the real client IP.
TRUST_PROXY="false"

# Log level: "info" logs all requests, anything else logs only 4xx/5xx.
LOG_LEVEL="info"

# ---- Rate limiting -------------------------------------------------
# General API limiter
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=120
# Analysis endpoint (expensive - keep it tight)
ANALYZE_RATE_LIMIT_WINDOW_MS=60000
ANALYZE_RATE_LIMIT_MAX=8
# Chat endpoint
CHAT_RATE_LIMIT_WINDOW_MS=60000
CHAT_RATE_LIMIT_MAX=30

# ---- Payload limits ------------------------------------------------
# Max decoded image size accepted by the API (bytes). Default 5 MB.
MAX_IMAGE_BYTES=5242880
# Max JSON request body size (bytes). Default 10 MB.
MAX_BODY_BYTES=10485760

# ---- Optional: frontend --------------------------------------------
# Only needed if the frontend is served from a different origin than
# the API (no Vite proxy / same-origin deployment). Example:
# VITE_API_BASE_URL="https://api.repairmate.example.com/api"
VITE_API_BASE_URL=""

# APP_URL: The URL where the app is hosted. Used for documentation/
# self-referential links and metadata only. No secret.
APP_URL="https://repair-mate-seven.vercel.app"